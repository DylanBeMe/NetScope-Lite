# Optional first-run dashboard password. Use at least 8 characters.
# NETSCOPE_PASSWORD=replace-with-a-long-local-password

# Optional comma-separated Host-header allowlist for LAN/reverse-proxy access.
# Use exact hostnames or IP addresses only; do not include a scheme or port.
# NETSCOPE_ALLOWED_HOSTS=192.168.1.50,netscope.example.local

# Host-network mode defaults to hiding Docker/Podman/CNI virtual networks from scan targets.
# Set to 1 only when you intentionally want those container networks listed and scannable.
# NETSCOPE_INCLUDE_VIRTUAL_TARGETS=0

# Optional host-network UI exposure. Keep loopback defaults unless LAN access is needed.
# NETSCOPE_HOST=0.0.0.0
# NETSCOPE_ALLOW_NON_LOOPBACK=1
